{
  "name": "opencode-statusline",
  "version": "0.2.0",
  "private": true,
  "description": "OpenCode V2 TUI statusline and provider quota plugin with zero context pollution.",
  "type": "module",
  "exports": {
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "doc",
    "README*.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/prepare-tui-dist.mjs",
    "build:check": "npm run build && npm pack --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "prepack": "npm run build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "statusline",
    "quota",
    "usage"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalcohol/opencode-statusline.git"
  },
  "bugs": {
    "url": "https://github.com/kalcohol/opencode-statusline/issues"
  },
  "homepage": "https://github.com/kalcohol/opencode-statusline#readme",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@opencode/client": "^2.2.1",
    "@opencode/plugin": "^2.2.1",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "@types/node": "^24.0.0",
    "babel-preset-solid": "1.9.12",
    "solid-js": "1.9.12",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@opencode/client": "^2.2.1",
    "@opencode/plugin": "^2.2.1",
    "@opentui/core": ">=0.7.0",
    "@opentui/solid": ">=0.7.0",
    "solid-js": ">=1.9.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
